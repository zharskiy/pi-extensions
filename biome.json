{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!future-plans", "!**/*.md", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noPrivateImports": "error"
      },
      "nursery": {
        "noSelfImport": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noRestrictedImports": "off"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/mcp-import/tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["pi-adapter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/extensions/**"],
                    "message": "This layer must not import extensions."
                  },
                  {
                    "group": ["**/extension-manager/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/ui-kit/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/shared/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/test-framework/**", "**/evals/**", "**/test/**"],
                    "message": "Shipped code never imports test code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["pi-adapter/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/extensions/**"],
                    "message": "This layer must not import extensions."
                  },
                  {
                    "group": ["**/extension-manager/**"],
                    "message": "Adapter tests use test-framework and the adapter only."
                  },
                  {
                    "group": ["**/ui-kit/**"],
                    "message": "Adapter tests use test-framework and the adapter only."
                  },
                  {
                    "group": ["**/shared/**"],
                    "message": "Adapter tests use test-framework and the adapter only."
                  },
                  {
                    "group": ["**/evals/**"],
                    "message": "Nothing imports evals/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "@earendil-works/*/**", "typebox", "typebox/**"],
                    "message": "Only pi-adapter/** may import pi packages."
                  },
                  {
                    "group": ["**/pi-adapter/**", "!**/pi-adapter/index.ts"],
                    "message": "Import pi-adapter only through pi-adapter/index.ts."
                  },
                  {
                    "group": ["**/extension-manager/**"],
                    "message": "shared/ may import pi-adapter/index.ts only (R5)."
                  },
                  {
                    "group": ["**/ui-kit/**"],
                    "message": "shared/ may import pi-adapter/index.ts only (R5)."
                  },
                  {
                    "group": ["**/extensions/**"],
                    "message": "This layer must not import extensions."
                  },
                  {
                    "group": ["**/test-framework/**", "**/evals/**", "**/test/**"],

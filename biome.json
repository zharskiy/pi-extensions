{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!research", "!**/*.md", "!.vitest"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/*/src/**", "!extensions/*/src/adapter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "typebox"],
                    "message": "Only src/adapter/** of an extension may import pi packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["extensions/*/test/**", "test/**", "!extensions/*/test/adapter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "typebox"],
                    "message": "Only the adapter tests in test/adapter/** of an extension may import pi packages."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

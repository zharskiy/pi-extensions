{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!docs", "!future-plans", "!**/*.md", "!.claude", "!.pi"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "noPrivateImports": "error"
      },
      "nursery": {
        "noSelfImport": "error"
      },
      "performance": {
        "noBarrelFile": "off",
        "noReExportAll": "error"
      },
      "suspicious": {
        "noImportCycles": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/mcp-import/tests/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["platform/pi-adapter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/extensions/**"],
                    "message": "This layer must not import extensions."
                  },
                  {
                    "group": ["**/extension-manager/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/ui-kit/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/shared/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/test/framework/**", "**/evals/**", "**/test/**"],
                    "message": "Shipped code never imports test code."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["platform/pi-adapter/types/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/extensions/**"],
                    "message": "This layer must not import extensions."
                  },
                  {
                    "group": ["**/extension-manager/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/ui-kit/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/shared/**"],
                    "message": "pi-adapter imports nothing from the repo (R3)."
                  },
                  {
                    "group": ["**/test/framework/**", "**/evals/**", "**/test/**"],
                    "message": "Shipped code never imports test code."
                  },
                  {
                    "group": ["../**"],
                    "message": "pi-adapter/types imports only other types/ files."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["platform/pi-adapter/tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [

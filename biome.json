{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!future-plans", "!**/*.md", "!.claude"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["extensions/mcp-import/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["core/**", "extensions/*/src/**", "!core/adapter/**", "!core/test/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "typebox"],
                    "message": "Only core/adapter/** may import pi packages."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["core/test/**", "extensions/*/test/**", "test/**", "!core/test/adapter/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@earendil-works/*", "typebox"],
                    "message": "Only the adapter tests in core/test/adapter/** may import pi packages."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}

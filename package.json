{
  "name": "@zharskiy/pinata",
  "version": "0.4.0",
  "description": "Extensions for the pi coding agent (background subagents, session limits, cost, notifications, a calmer terminal) and pi-sandbox, a launcher that runs pi in a container inside a Colima VM on macOS.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zharskiy/pi-extensions.git"
  },
  "homepage": "https://github.com/zharskiy/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/zharskiy/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "subagents",
    "session-limits",
    "spending",
    "working-indicator",
    "notifications",
    "command-aliases",
    "composer",
    "questionnaire",
    "style",
    "context",
    "footer",
    "mcp-import",
    "transcript",
    "model-default",
    "sandbox"
  ],
  "bin": {
    "pi-sandbox": "launcher/bin/pi-sandbox.js"
  },
  "files": [
    "launcher",
    "!launcher/bin/pi-sandbox-dev.js",
    "!launcher/tsconfig.build.json",
    "platform",
    "extensions/*/index.ts",
    "extensions/*/api/**",
    "extensions/*/core/**",
    "extensions/*/ui/**",
    "extensions/*/prompts/**",
    "extensions/subagents/agents",
    "extensions/*/README.md",
    "README.md",
    "CHANGELOG.md",
    "INSTALL.md",
    "install.sh",
    "LICENSE",
    "ARCHITECTURE.md",
    "STRUCTURE.md",
    "AGENTS.md",
    "!**/tests/**"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagents/index.ts",
      "./extensions/session-limits/index.ts",
      "./extensions/spending/index.ts",
      "./extensions/working-indicator/index.ts",
      "./extensions/notifications/index.ts",
      "./extensions/command-aliases/index.ts",
      "./extensions/composer/index.ts",
      "./extensions/questionnaire/index.ts",
      "./extensions/style/index.ts",
      "./extensions/context/index.ts",
      "./extensions/footer/index.ts",
      "./extensions/mcp-import/index.ts",
      "./extensions/transcript/index.ts",
      "./extensions/model-default/index.ts"
    ]
  },
  "scripts": {
    "build:launcher": "rm -rf launcher/dist && tsc -p launcher/tsconfig.build.json",
    "prepack": "npm run build:launcher",
    "test": "vitest run --project unit",
    "test:live": "vitest run --project live --reporter verbose",
    "evals": "vitest run --project evals --reporter verbose",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^24.0.0",
    "knip": "^6.43.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

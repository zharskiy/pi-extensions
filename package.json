{
  "name": "pi-extensions-mz",
  "version": "0.3.0",
  "description": "Extensions for the pi coding agent: background subagents you run, watch and message from the main session, main session limits that hand the conversation over to a new session before its context fills up, a spending footer with the session's total cost including subagents, and a multi-line status footer.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "session-limits",
    "spending",
    "footer"
  ],
  "files": [
    "core/adapter",
    "core/manager",
    "extensions/*/src/**",
    "extensions/*/prompts/**",
    "extensions/subagents/agents",
    "extensions/*/README.md",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md",
    "STRUCTURE.md",
    "AGENTS.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagents/src/index.ts",
      "./extensions/session-limits/src/index.ts",
      "./extensions/spending/src/index.ts",
      "./extensions/footer/src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

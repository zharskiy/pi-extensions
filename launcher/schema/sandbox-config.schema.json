                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "mcpOAuth": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "server": {
                                "type": "string",
                                "minLength": 1
                              },
                              "url": {
                                "type": "string",
                                "format": "uri",
                                "pattern": "^https://"
                              }
                            },
                            "required": ["server", "url"]
                          }
                        },
                        "required": ["mcpOAuth"],
                        "description": "The OAuth token of an MCP server signed in with pi mcp login."
                      }
                    ]
                  }
                },
                "required": ["id", "host", "secret"],
                "anyOf": [
                  {
                    "required": ["placeholder"]
                  },
                  {
                    "required": ["header"]
                  }
                ]
              },
              "description": "Credential rules. Not in a project config; a lower layer may only drop rules set above."
            },
            "derive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"

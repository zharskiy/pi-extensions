          "description": "Names that may resolve to private addresses; never IP literals or loopback. Not in a project config; only narrows below."
        },
        "parentProxy": {
          "oneOf": [
            {
              "enum": ["env", "none"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^http://"
                },
                "noProxy": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\.?(\\*\\.)?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*(:[0-9]{1,5})?$"
                  }
                },
                "auth": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "env": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        }
                      },
                      "required": ["env"],
                      "description": "An environment variable of the launcher, read at launch and handed to the proxy in memory."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "file": {
                          "type": "string",
                          "pattern": "^(/|~$|~/)"
                        },
                        "pointer": {
                          "type": "string",
                          "pattern": "^(/([^~/]|~[01])*)+$"
                        }
                      },
                      "required": ["file", "pointer"],
                      "description": "A JSON pointer into a host file."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "command": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "ttlSeconds": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": ["command"],
                      "description": "A host command; stdout trimmed, or JSON { token, expiresAt }. Cached for ttlSeconds (default 300)."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "piAuth": {
                          "type": "string",
                          "minLength": 1
                        },
                        "bearer": {
                          "type": "boolean"
                        }
                      },
                      "required": ["piAuth"],
                      "description": "The host pi credential of this provider id."
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mcpOAuth": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "server": {
                              "type": "string",
                              "minLength": 1
                            },
                            "url": {
                              "type": "string",
                              "format": "uri",
                              "pattern": "^https://"
                            }
                          },
                          "required": ["server", "url"]
                        }
                      },
                      "required": ["mcpOAuth"],
                      "description": "The OAuth token of an MCP server signed in with pi mcp login."
                    }
                  ]
                }
              },
              "required": ["url"]
            }
          ],
          "description": "Upstream proxy: env (host HTTPS_PROXY, the default), none, or a URL. Not in a project config; fixed when set above."
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxHours": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "permanent": {
              "type": "boolean"
            }
          },
          "description": "Limits for pi sandbox egress allow. Not in a project config; can only turn off or shrink below."
        }
      }
    },
    "workspaceRoots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/|~$|~/)"
          }
        },
        "outside": {
          "enum": ["refuse", "warn"]
        }
      },
      "required": ["roots", "outside"]
    },
    "mounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraReadOnly": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/|~$|~/)"
          }
        },
        "cacheVolumes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!(.*/)?\\.\\.(/|$))"
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "allOf": [
              {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              {
                "not": {
                  "pattern": "[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Kk][Ee][Yy]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]"
                }
              },
              {
                "not": {
                  "enum": ["PI_CODING_AGENT_DIR", "PI_CODING_AGENT_SESSION_DIR"]
                }
              }
            ],
            "description": "Environment variable forwarded from the host; names that look like secrets, and the agent and session directory variables the launcher sets, are refused."
          }
        }
      },
      "description": "env.allow may not be set by a project config."
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "boolean",
          "description": "Forward the host ssh agent into the container. Off by default; a project config cannot turn it on."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "memoryGiB": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "boolean",
          "description": "Keep this repository's pi sessions in host pi's own session directory, so host pi lists them. On by default; policy or org may turn it off and lock it, a project config may not set it."
        }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extraCa": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": "^(/|~$|~/)"
                  }
                },
                "required": ["file"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hostStore": {
                    "const": true
                  }
                },
                "required": ["hostStore"]
              }
            ]
          }
        }
      },
      "description": "Extra CA certificates trusted by the proxy, the container and image builds. Not in a project config; only narrows below."
    },
    "org": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(/|~$|~/|https://)"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "refreshHours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": ["source"],
      "description": "Organisation baseline layer (a file path or an https URL), merged between policy and user. Only in the policy or user config."
    }
  }
}

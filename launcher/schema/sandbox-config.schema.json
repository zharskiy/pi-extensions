          "description": "Hosts never allowed, granted or derived; the union of every layer. Not in a project config."
        },
        "privateHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(\\*\\.)?[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*$"

{
  "fallback": "refuse",
  "egress": {
    "allow": ["gateway.example.internal", "registry.example.internal", "git.example.internal"],
    "mcpHosts": ["mcp.example.internal"],
    "deny": ["paste.example.com"],
    "privateHosts": ["gateway.example.internal", "registry.example.internal", "git.example.internal"],
    "parentProxy": { "url": "http://proxy.example.internal:3128", "noProxy": [".example.internal"] },
    "grants": { "enabled": false, "maxHours": 8, "permanent": false }
  },
  "credentials": {
    "derive": { "enabled": false },
    "rules": [
      {
        "id": "llm-gateway",
        "host": "gateway.example.internal",
        "placeholder": "pi-sandbox-llm-gateway",
        "header": "authorization",
        "template": "Bearer {secret}",
        "secret": {
          "command": ["/usr/local/bin/example-sso", "token", "--audience", "gateway"],
          "ttlSeconds": 300
        }
      },
      {
        "id": "package-registry",
        "host": "registry.example.internal",
        "pathPrefix": "/npm/",
        "placeholder": "pi-sandbox-package-registry",
        "header": "authorization",
        "template": "Bearer {secret}",
        "secret": { "env": "EXAMPLE_REGISTRY_TOKEN" }
      }
    ]
  },
  "tls": { "extraCa": [{ "file": "/etc/ssl/certs/example-root-ca.pem" }] },
  "image": { "packages": ["jq", "ripgrep", "git"] },
  "ssh": { "agent": false }
}

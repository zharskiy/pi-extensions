{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023"]
  },
  "include": [
    "pi-adapter",
    "extension-manager",
    "ui-kit",
    "shared",
    "extensions",
    "test-framework",
    "evals",
    "test",
    "vitest.config.ts"
  ]
}
